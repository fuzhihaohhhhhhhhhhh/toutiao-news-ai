# ═══════════════════════════════════════════════════════════
# 环境变量模板
#
#   复制成 .env 后再填入你自己的值：
#       Copy-Item .env.example .env          (PowerShell)
#       cp .env.example .env                 (bash)
#
# .env 已被 .gitignore 排除，永远不会进入版本库。
# ═══════════════════════════════════════════════════════════

# ──────────────── 大模型（必填）────────────────
# 阿里云百炼 / DashScope。本项目通过它的 **OpenAI 兼容端点** 调用模型与向量嵌入，
# 并没有引入 dashscope 原生 SDK，所以这里只需要一个 OpenAI 风格的 key。
DASHSCOPE_API_KEY=sk-替换成你自己的Key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ──────────────── 大模型（可选，当前代码未使用）────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 联网搜索（可选，当前代码未使用，属早期模板残留）
TAVILY_API_KEY=

# ──────────────── LangSmith 链路追踪（可选）────────────────
# 建议保持 false。改成 true 并按提示配置后，
# 你的每一次对话内容与检索结果都会被上传到 LangSmith 账号。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=toutiao-news

# ──────────────── MySQL：业务库（用户/新闻/收藏/历史）────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=替换成你自己的密码
MYSQL_DB=news_app

# ──────────────── PostgreSQL：AI 聊天库（会话/消息）────────────────
# 故意与业务库分库：聊天数据写入频繁且与业务无关，分开便于独立扩容与清理
PG_HOST=localhost
PG_PORT=5433
PG_USER=chatuser
PG_PASSWORD=替换成你自己的密码
PG_DB=chat_db

# ──────────────── Redis：缓存与限流 ────────────────
# 没有设密码就留空（空值会被转成 None，不会发送 AUTH）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
