# ═══════════════════════════════════════════════════════════
# 密钥与本地配置 —— 绝对不能提交
# ═══════════════════════════════════════════════════════════
.env
.env.local
.env.*.local
# 但模板要提交（! 规则必须写在排除规则之后才生效）
!.env.example

# ═══════════════════════════════════════════════════════════
# Python
# ═══════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# ═══════════════════════════════════════════════════════════
# 运行时产物（都可从数据库重新生成，不入库）
# ═══════════════════════════════════════════════════════════
logs/
*.log
# Chroma 向量库与它的增量索引指纹必须成对处理：
# 只保留其中一个会导致"指纹说已索引、但向量库里没有"的错乱状态，
# 因此两者都不入库，改由 backend/scripts/build_vector.py 重新生成。
# 指纹文件现已移动到 chroma_db/ 内部（见 config/chroma.yml 的 md5_hex_store），
# 下面保留 md5.text 一行只为兼容早期版本放在 backend/ 根目录的写法。
chroma_db/
md5.text
# 评测/压测跑出来的报告属于本地产物
text/*_report_*.md
text/*_report_*.json
text/eval_set.draft.json

# ═══════════════════════════════════════════════════════════
# 前端
# ═══════════════════════════════════════════════════════════
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ═══════════════════════════════════════════════════════════
# IDE / 操作系统
# ═══════════════════════════════════════════════════════════
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ═══════════════════════════════════════════════════════════
# 个人工作日志（含本地路径与个人记录，不入库）
# ═══════════════════════════════════════════════════════════
.workbuddy/

# ═══════════════════════════════════════════════════════════
# 网盘同步残留文件（如百度云未下载完的 *.baiduyun.p.downloading）
# ═══════════════════════════════════════════════════════════
*.baiduyun.p.downloading
